#!/bin/sh
# Light checks before every commit: lint and unit tests, and only when code changed.
# The slow checks (typecheck, build tests, e2e) run in pre-push (pnpm verify:full).
# Bypass once with: git commit --no-verify
if ! git diff --cached --name-only | grep -qE '^(src|tests|scripts|public)/|^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|astro\.config\.[^/]+|tsconfig\.json|eslint\.config\.[^/]+|playwright\.config\.ts|vitest\.config\.[^/]+)$'; then
  echo "pre-commit: no code changes staged, skipping checks"
  exit 0
fi
pnpm lint && pnpm test
