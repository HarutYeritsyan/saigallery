{
  "name": "saigallery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:host": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0 --port 4321 --ignore-lock",
    "dev:local": "EXHIBITS_DIR=./local-exhibits pnpm dev:host",
    "build": "node scripts/verify-exhibits.mjs && astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro check --minimumFailingSeverity error --minimumSeverity error",
    "test": "vitest run tests/unit",
    "test:build": "SITE_URL=http://localhost:4321 EXHIBITS_DIR=tests/fixtures/exhibits pnpm build && vitest run tests/build",
    "test:e2e": "playwright test",
    "design:preview": "python3 -m http.server 4400 --bind 0.0.0.0 --directory design/gallery-museum/preview",
    "exhibit:add": "node scripts/exhibit-add.mjs",
    "exhibit:unpublish": "node scripts/exhibit-unpublish.mjs",
    "exhibit:verify": "node scripts/verify-exhibits.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:build",
    "verify:full": "pnpm verify && pnpm test:e2e",
    "hooks:install": "git config core.hooksPath .githooks",
    "sdd:status": "node .specify/scripts/sdd-status.mjs"
  },
  "dependencies": {
    "astro": "7.3.3",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "17.12.0",
    "node-html-parser": "9.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.1"
  }
}
