---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { catalogNumber, displayTitle, isPublished, pad3 } from '../lib/exhibits';
import Cordon from './Cordon.astro';

interface Props {
  entry: CollectionEntry<'exhibits'>;
  eager?: boolean;
}

const { entry, eager = false } = Astro.props;
if (!isPublished(entry)) throw new Error(`Exhibit ${entry.id} is not published`);
const { image, alt } = entry.data;
---

<li class="exhibit-card">
  <a href={`/exhibits/${pad3(catalogNumber(entry.id))}/`}>
    {/* The gold frame is at most 14rem wide at every layout width (gallery.css). */}
    <span class="frame">
      <Image
        src={image}
        alt={alt}
        widths={[240, 480]}
        sizes="14rem"
        loading={eager ? 'eager' : 'lazy'}
      />
    </span>
    <span class="pillow" aria-hidden="true"></span>
    <span class="card-title">{displayTitle(entry)}</span>
  </a>
  <Cordon />
</li>
